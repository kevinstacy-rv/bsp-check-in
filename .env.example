# HubSpot private app access token (Settings → Integrations → Private Apps).
# Scopes: crm.lists.read, crm.lists.write, crm.objects.contacts.read,
# crm.objects.contacts.write, crm.objects.companies.read,
# crm.schemas.contacts.read, crm.schemas.contacts.write,
# analytics.behavioral_events.send, behavioral_events.event_definitions.read_write
HUBSPOT_TOKEN=

# Password staff type to unlock the check-in station.
STAFF_PASSWORD=

# Long random string used to sign the staff session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Optional: contact properties written on check-in (created automatically if missing).
# HUBSPOT_CHECKIN_EVENT_PROPERTY=event_check_in_name
# HUBSPOT_CHECKIN_TIME_PROPERTY=event_check_in_at
